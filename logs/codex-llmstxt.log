tests/               # pytest >=24 test: parse sitemap (fixture xml), extract (fixture html),
                     # grouper, render (so khớp chuỗi output mong đợi). KHÔNG network trong test.
fixtures/            # sitemap mẫu, vài html mẫu (tự soạn)
